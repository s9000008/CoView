# ==============================================================================
# CoView WebSocket Server - 環境變數範本檔 (.env.example)
# 
# ⚠️ 注意事項：
# 1. 本檔案僅作為公開範本，請複製為 .env 並填入適當數值。
# 2. 真實的 .env 已被 .gitignore 忽略，嚴禁提交任何真實私鑰至 Git 倉庫。
# 3. 若於 Fly.io 生產環境運行，請透過 `fly secrets set` 指令進行注入。
# ==============================================================================

# 伺服器監聽通訊埠 (預設 3000)
PORT=3000

# 跨來源資源共享 (CORS) 允許來源
# 本地測試或開放模式可設為 *；生產環境可指定為前端套件擴充網址或特定網域
CORS_ORIGIN=*

# 日誌輸出等級 (可選: error, warn, info, debug)
LOG_LEVEL=info

# Node.js 執行環境模式 (可選: development, production)
NODE_ENV=production
